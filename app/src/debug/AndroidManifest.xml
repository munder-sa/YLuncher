<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>

        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:label="GT8D Spike"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".spike.SpikePanelActivity"
            android:exported="false"
            android:label="GT8D Spike Panel"
            android:resizeableActivity="true" />

        <receiver
            android:name=".spike.SpikeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gt8d.launcher.spike.RUN" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
